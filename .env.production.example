# Paths refer to operator-managed files outside the repository. Never commit real values.
# A database connection file contains runtime credentials, SslMode=VerifyFull,
# Pooling=true;Maximum Pool Size=100;Timeout=15;Command Timeout=30;Include Error Detail=false.
API_ALLOWED_HOSTS=api.example.invalid
JWT_ISSUER=Groudeal
JWT_AUDIENCE=Groudeal.Client
DATABASE_CONNECTION_FILE=/absolute/managed/secrets/runtime-connection
JWT_SIGNING_KEY_FILE=/absolute/managed/secrets/jwt-key
DP_CERTIFICATE_FILE=/absolute/managed/secrets/data-protection.pfx
DP_CERTIFICATE_PASSWORD_FILE=/absolute/managed/secrets/data-protection-password
DP_KEYS_PATH=/absolute/managed/persistent/dp-keys
EDGE_CERTIFICATE_FILE=/absolute/managed/secrets/tls-chain.pem
EDGE_PRIVATE_KEY_FILE=/absolute/managed/secrets/tls-private-key.pem
EDGE_IMAGE=nginx:stable-alpine@sha256:<operator-reviewed-digest>
